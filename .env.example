# Environment configuration template
# Copy this file to .env for local overrides. DO NOT commit real secrets or credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Connection String (psycopg3 driver)
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/industrial_inspection

